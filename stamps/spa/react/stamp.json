{
  "$schema": "../../../stamp.schema.json",
  "description": "React single page app with Vite, TanStack Router and Query, Zustand, Tailwind CSS, Vitest and Biome",
  "mode": "project",
  "prompts": [
    {
      "name": "name",
      "message": "What is the project name?"
    },
    {
      "name": "description",
      "message": "Project description:",
      "default": "A React single page application"
    },
    {
      "name": "author",
      "message": "Author name:",
      "default": "Yves Kaufmann <yv35kaufmann@gmail.com>"
    }
  ],
  "includes": ["editorconfig:ts", "vitest:ts", "biome:ts", "gitignore:node"],
  "patches": [
    {
      "file": "biome.json",
      "merge": {
        "files": {
          "includes": ["!!**/src/routeTree.gen.ts"]
        },
        "css": {
          "parser": {
            "tailwindDirectives": true
          }
        }
      }
    },
    {
      "file": ".vscode/extensions.json",
      "merge": {
        "recommendations": ["bradlc.vscode-tailwindcss"]
      }
    },
    {
      "file": ".vscode/settings.json",
      "merge": {
        "css.lint.unknownAtRules": "ignore",
        "files.readonlyInclude": {
          "**/routeTree.gen.ts": true
        },
        "files.watcherExclude": {
          "**/routeTree.gen.ts": true
        },
        "search.exclude": {
          "**/routeTree.gen.ts": true
        }
      }
    }
  ]
}

# Copy this file to .env.local and adjust it. Only variables starting with VITE_ end up in the browser bundle.

# Port of the Vite dev server. Point the reverse proxy of your backend to it.
DEV_PORT=5173
# Interface the dev server listens on, use 0.0.0.0 inside a container.
DEV_HOST=localhost
# Path the app is served under, e.g. /app/. Must start and end with "/".
BASE_PATH=/
# Where `npm run build` writes the bundle, e.g. ../server/web/dist for a Go embed.
OUT_DIR=dist

# Optional: forward /api of the dev server to a backend, for when you open the Vite dev server directly.
# API_PROXY_TARGET=http://localhost:8080

# Optional: only needed when HMR cannot reach the dev server through the reverse proxy, see README.
# HMR_CLIENT_PORT=5173
# DEV_ORIGIN=http://localhost:5173

# Base URL of the API as the browser sees it.
VITE_API_BASE_URL=/api

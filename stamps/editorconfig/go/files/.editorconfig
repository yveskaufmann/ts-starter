# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# gofmt indents with tabs
[{*.go,go.mod}]
indent_style = tab
tab_width = 4
indent_size = 4

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
tab_width = 4

{
  "name": "@yveskaufmann/ts-starter",
  "version": "0.0.1",
  "description": "Personal TypeScript project starter template",
  "main": "./index.js",
  "module": "./index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ts-starter": "./index.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "change-case": "^5.4.4",
    "diff": "^9.0.0",
    "handlebars": "^4.7.10",
    "plop": "^4.0.5"
  },
  "files": [
    "templates",
    "index.js",
    "plopfile.js"
  ],
  "devDependencies": {
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "plop",
    "template",
    "typescript"
  ],
  "author": "Yves Kaufmann <yv35kaufmann@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/yveskaufmann/ts-starter.git"
  },
  "bugs": {
    "url": "https://github.com/yveskaufmann/ts-starter/issues"
  },
  "homepage": "https://github.com/yveskaufmann/ts-starter",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "format:check": "prettier --check src vitest.config.js",
    "format": "prettier --write src vitest.config.js"
  }
}

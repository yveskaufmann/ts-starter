{
  "name": "@yveskaufmann/ts-starter",
  "version": "0.0.1",
  "description": "Personal project starter: create apps and add small stamps like an editorconfig",
  "main": "./index.js",
  "module": "./index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ts-starter": "./index.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "change-case": "^5.4.4",
    "diff": "^9.0.0",
    "handlebars": "^4.7.10"
  },
  "files": [
    "stamps",
    "src",
    "index.js",
    "!src/**/*.spec.js",
    "!src/**/test-helpers.js"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "semantic-release": "^25.0.9",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "starter",
    "scaffold",
    "stamp",
    "template",
    "typescript"
  ],
  "author": "Yves Kaufmann <yv35kaufmann@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/yveskaufmann/ts-starter.git"
  },
  "bugs": {
    "url": "https://github.com/yveskaufmann/ts-starter/issues"
  },
  "homepage": "https://github.com/yveskaufmann/ts-starter",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "check": "biome check --write .",
    "format:check": "biome check .",
    "format": "biome check --write ."
  }

dist
build/
",
  ".nvmrc": "lts/krypton
",
  ".prettierrc.json": "{
  "printWidth": 120,
  "singleQuote": true,
  "proseWrap": "always",
  "quoteProps": "consistent"
}
",
  ".vscode/launch.json": "{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Application",
      "runtimeExecutable": "tsx",
      "program": "\${workspaceFolder}/src/index.ts",
      "cwd": "\${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Spec File",
      "program": "\${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "\${relativeFile}"],
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "cwd": "\${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "Attach to Running Application",
      "port": 9992,
      "request": "attach",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    }
  ]
}
",
  ".vscode/settings.json": "{
  "typescript.preferences.importModuleSpecifier": "project-relative",
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "javascript.preferences.importModuleSpecifier": "project-relative",
  "javascript.preferences.importModuleSpecifierEnding": "js"
}
",
  "Makefile": "SHELL=/bin/bash

.DEFAULT_GOAL := build

# Default arguments for the Makefile targets e.g make build ARGS="--flag"
ARGS ?=


########################################################################################################################
#
# Project dev targets
#
########################################################################################################################
.PHONY: build
build: node_modules 					## Build the project
	npx tsc

package-lock.json:           ## Initialize the package lock file if it doesn't exist
	npm install

node_modules: package.json package-lock.json
ifeq ($(CI), true)
	npm ci
else
	npm install
endif

.PHONY: setup
setup: clean 										## Setup the project environment
	npm install
	$(MAKE) build

.PHONY: clean
clean:													## Clean up the build artifacts
	rm -rf dist

.PHONY: start run
run: start
start: 													## Start the application in development mode
	npx tsx --watch \\
		--inspect=9992 src/index.ts $(ARGS)

.PHONY: test
test: 													## Run the tests
	npx vitest run $(ARGS)

.PHONY: help
help: 													## Render the possible targets in this Makefile along with their descriptions
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) |  awk 'BEGIN {FS = ":.*?## "}; {printf "\\033[36m%-30s\\033[0m %s\\n", $$1, $$2}'cat
",
  "README.md": "# Demo App

A demo & more

## Installation
",
  "package.json": "{
  "name": "demo-app",
  "description": "A demo & more",
  "author": "Me <me@example.org>",
  "private": true,
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "version": "1.0.0",
  "scripts": {
    "build": "make",
    "clean": "make clean",
    "start": "make start",
    "test": "make test"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
",
  "src/index.ts": "console.info('Hello, world! This is a message from the print function.');
",
  "src/sum.spec.ts": "import { describe, expect, it } from 'vitest';
import { sum } from './sum.js';

describe('Sum', () => {
  it('should return the sum of two numbers', () => {
    expect(sum(1, 2)).toBe(3);
    expect(sum(-1, 1)).toBe(0);
    expect(sum(0, 0)).toBe(0);
    expect(sum(-5, -5)).toBe(-10);
  });
});
",
  "src/sum.ts": "/**
 * Export a function that sums two numbers.
 * @param a - The first number to sum.
 * @param b - The second number to sum.
 * @returns The sum of the two numbers.
 */
export function sum(a: number, b: number): number {
  return a + b;
}
",
  "tsconfig.json": "{
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    // Target & language configuration Specify ECMAScript target version.
    "target": "es2020",
    "lib": ["ES2024"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Module configuration
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    // Type declarations to include, TypeScript >= 6 no longer includes all @types packages by default
    "types": ["node"],
    // Input and output directories
    "rootDir": "./src",
    "outDir": "./dist",
    // Emit additional JavaScript to ease support for importing CommonJS modules. This enables 'allowSyntheticDefaultImports' for type compatibility.
    "esModuleInterop": true,
    // Ensure that casing is correct in imports.
    "forceConsistentCasingInFileNames": true,
    // Enable all strict type-checking options.
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    // Emit source maps for debugging
    "sourceMap": true,
    "inlineSources": true
  }
}
",
  "vitest.config.ts": "import { defineConfig } from 'vitest/config';

export default defineConfig({
  test: {
    environment: 'node',
    include: ['src/**/*.spec.ts'],
    exclude: ['dist/**', 'node_modules/**'],
  },
});
",
}
`;
